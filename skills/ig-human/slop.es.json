  "structures": [
    {
      "id": "no-solo",
      "regex": "(?i)\\bno (?:es|se trata de) (?:solo|sólo|solamente|únicamente) [^.!?\\n—]{2,60}\\s*[,.;—]\\s*(?:es|se trata de)\\b",
      "name": "«No es solo X, es Y»",
      "fix": "Di lo único que quieres decir. Borra la mitad que prepara."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
      "name": "«No solo X, sino también Y»",
      "fix": "Pártelo en dos frases o quita la mitad más floja."
    },
    {
      "id": "no-va-de",
      "regex": "(?i)\\b(?:esto|no) (?:no )?(?:va|trata|se trata) de [^.!?\\n]{2,60}[.!]\\s*(?:va|trata|se trata) de\\b",
      "name": "«Esto no va de X. Va de Y.»",
      "fix": "Empieza por Y. El giro es la señal."
    },
    {
      "id": "el-resultado",
      "regex": "(?im)^\\s*¿?\\s*(?:el resultado|lo mejor|la clave|el truco|el problema|la trampa|lo peor|la sorpresa)\\s*\\?\\s*$",
      "name": "Pregunta retórica de una línea («¿El resultado?»)",
      "fix": "Responde en la misma frase en vez de escenificar una revelación."
    },
    {
      "id": "esto-aprendi",
      "regex": "(?i)\\besto es lo que (?:aprendí|aprendimos|he aprendido|hemos aprendido)\\b|\\blo que (?:aprendí|aprendimos|he aprendido|hemos aprendido)\\s*:",
      "name": "«Esto es lo que aprendí»",
      "fix": "Di la lección. Sáltate el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b\\w+, \\w+ (?:y|e) \\w+\\.",
      "name": "Tríada de tres",
      "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto del modelo."
    },
    {
      "id": "cohete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de cohete / fuego / bombilla / chispas / diana",
      "fix": "Un emoji como mucho, y que no sea uno de estos cinco."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Muro de hashtags (6 o más)",
      "fix": "Instagram cuenta cinco como mucho. Tres a cinco temas concretos, o ninguno."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial)\\b|\\bcomo (?:un )?modelo de lenguaje\\b",
      "name": "El modelo hablando de sí mismo",
      "fix": "Borra la frase."
    },
    {
      "id": "en-resumen",
      "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|para resumir|en definitiva)\\b",
      "name": "Apertura de cierre de redacción",
      "fix": "Una publicación no necesita párrafo de conclusión."
    },
    {
      "id": "cebo-interaccion",
      "regex": "(?i)¿\\s*(?:estás de acuerdo|qué opinas|qué piensas|me equivoco|quién más\\b[^?\\n]*|y tú\\b[^?\\n]*)\\?\\s*$",
      "name": "Pregunta de enganche por reflejo",
      "fix": "Haz una pregunta que solo podrías hacer tú, sobre lo concreto que acabas de contar."
    },
    {
      "id": "deja-scroll",
      "regex": "(?im)^\\s*(?:deja de hacer scroll|para de hacer scroll|no hagas scroll|deja de deslizar|no sigas (?:bajando|deslizando)|espera,? no (?:hagas scroll|deslices|pases))\\b",
      "name": "Apertura «deja de hacer scroll»",
      "fix": "Lo que para el scroll tiene que ser la afirmación misma. Pedir atención es la señal de que no te la has ganado."
    },
    {
      "id": "en-este-video",
      "regex": "(?i)\\b(?:en este (?:v[ií]deo|reel|post)|en el (?:v[ií]deo|reel|post) de hoy|hoy (?:te|os|les) voy a (?:enseñar|mostrar|contar|explicar)|(?:te|os|les) voy a (?:enseñar|mostrar|explicar) cómo)\\b",
      "name": "Preámbulo de vídeo («en este vídeo te voy a enseñar»)",
      "fix": "Bórralo y empieza por el resultado. Los dos primeros segundos deciden todo el reel."
    },
    {
      "id": "vinetas-emoji",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista con emojis como viñetas",
      "fix": "Usa un guion o un salto de línea. Las viñetas con emoji son lo que más huele a plantilla en un texto."
    },
    {
      "id": "mayusculas",
      "regex": "\\b[A-ZÁÉÍÓÚÑÜ]{3,}\\b(?:[ \\t]+\\b[A-ZÁÉÍÓÚÑÜ]{3,}\\b){2,}",
      "name": "Tres o más palabras gritadas seguidas",
      "fix": "Las mayúsculas son un control de volumen, no un subrayador. Una palabra, como mucho."
    },
    {
      "id": "cebo-seguir",
      "regex": "(?i)\\b(?:sígueme para más|sigueme para mas|etiqueta a (?:alguien|un amigo|una amiga|ese amigo|esa amiga)|doble tap si|dale like si|comparte esto si|comenta (?:abajo )?si)\\b",
      "name": "Cebo de seguir o etiquetar por reflejo",
      "fix": "Pide la única acción que esta publicación se ha ganado. La petición genérica enseña a la audiencia a ignorar todas."
    },
    {
      "id": "pregunta-retorica-inicial",
      "regex": "(?im)^\\s*¿\\s*(?:alguna vez te has preguntado|te has preguntado alguna vez|sabías que|y si te dijera)\\b",
      "name": "Apertura con pregunta retórica («¿Alguna vez te has preguntado...?»)",
      "fix": "Responde la pregunta en la primera línea y quita la pregunta."
    },
    {
      "id": "mayusculas-inglesas",
      "regex": "(?m)^(?:[A-ZÁÉÍÓÚÑ][a-záéíóúñü]+[ \\t]+){3,}[A-ZÁÉÍÓÚÑ][a-záéíóúñü]+\\b",
      "name": "Mayúsculas a la inglesa («Cómo Hacer Crecer Tu Marca»)",
      "fix": "En español solo va en mayúscula la primera palabra y los nombres propios."
    },
    {
      "id": "exclamaciones",
      "regex": "(?:¡?[^!\\n]{1,80}!+[ \\t]*){3,}",
      "name": "Tres exclamaciones seguidas",
      "fix": "Una exclamación pesa más cuando está sola. Deja una, como mucho."
    }
  ]
}
